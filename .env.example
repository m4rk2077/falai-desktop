# --- Desktop (modo local / BYOK) ---------------------------------------------
# Sua própria chave Groq: https://console.groq.com/keys
GROQ_API_KEY=
DEFAULT_LANGUAGE=pt
# local (padrão, sem conta) | cloud (exige o backend Supabase)
FALAI_RUNTIME_MODE=local
# Repo de releases para o aviso de atualização (owner/repo)
# FALAI_UPDATE_REPO=

# --- Desktop (modo nuvem, opcional) ------------------------------------------
# Só se você hospedar o backend Supabase deste repo. Use a chave PÚBLICA (anon/publishable).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Backend (Supabase Edge Functions) ---------------------------------------
# Configure como secrets do Supabase (supabase secrets set ...). NUNCA no cliente.
# SUPABASE_SERVICE_ROLE_KEY=
# GROQ_CORRECTOR_MODEL=qwen/qwen3.8-27b
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# ALLOWED_ORIGINS=
